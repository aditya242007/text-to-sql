# ============================================================
# Environment Variables — copy to .env and fill in real values
# NEVER commit .env to git
# ============================================================

# --- Database connections ---
# Admin connection (used only by seed script, never the app at runtime)
DATABASE_URL_ADMIN=postgresql+psycopg://postgres:postgres@localhost:5432/analytics

# Read-only connection (used by the app at all times)
DATABASE_URL_RO=postgresql+psycopg://analytics_ro:analytics_ro@localhost:5432/analytics

# --- LLM provider selection ---
# Options: gemini | openai | groq
LLM_PROVIDER=gemini

# Model name for the chosen provider
# Examples: gemini-2.0-flash, gpt-4o, llama-3.1-70b-versatile
LLM_MODEL=gemini-2.0-flash

# Optional comma-separated fallback chain (tried in order if primary fails)
# LLM_FALLBACK_PROVIDERS=openai,groq

# --- LLM API keys (only set the one(s) you have) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Application settings ---
APP_TIMEZONE=Asia/Kolkata

# DB query timeout in milliseconds
SQL_TIMEOUT_MS=10000

# Maximum rows returned per query
SQL_MAX_ROWS=1000

# Schema introspection cache TTL in seconds
SCHEMA_CACHE_TTL_S=300
